# 禁止 latest / stable / main 等可变标签；发布后可进一步锁定 @sha256。
# 默认仅本机；部署 fnOS 时改为 NAS 的局域网 IPv4，不能填 0.0.0.0。
LAN_BIND_IP=127.0.0.1
# Picflow 网页端口；旧变量 PHOFLOW_PORT 与 PICPEAK_PORT 仍兼容。
PICFLOW_PORT=3000
PICFLOW_GITHUB_REPOSITORY=Aanlik/Picflow
# 同一镜像中的 Bridge 通过容器内部接口连接 Picflow；无需单独令牌。
POLL_SECONDS=30
STABLE_SECONDS=10
MAX_FINAL_BYTES=104857600
HISTORY_KEEP=3
# auto: 仅只读原始 inode 尝试 hardlink，再 reflink，再 copy；copy:强制隔离副本。
RAW_MATERIALIZE_MODE=auto

# Camera（包括 RAW 原片目录）对 Picflow 与 Bridge 始终只读。
NAS_CAMERA_ROOT=/vol1/1000/Home/Camera
# Picflow 中的 Camera 相对路径（如 RAW/26-10-04）由 Bridge 从此根目录解析。
NAS_RAW_ROOT=/vol1/1000/Home/Camera
# Camera 目录属主 UID/GID；用于让 Picflow 只读浏览已有照片。
NAS_CAMERA_UID=1000
NAS_CAMERA_GID=1000
# 在 Camera 下新建 PixCakeDelivery 文件夹，并授予 Bridge 对应 UID/GID 写入权限。
# 该子目录单独可写挂载；Camera 根挂载仍保持只读。
NAS_DELIVERY_ROOT=/vol1/1000/Home/Camera/PixCakeDelivery
# Optional legacy setting only: keep existing per-project mounts in this map during migration.
# New project workspaces are created under NAS_DELIVERY_ROOT, grouped by their Camera-relative folder.
# PROJECT_DELIVERY_MOUNTS='{"1":{"container":"/delivery-project","host":"/vol1/1000/Home/Camera/PixCakeDelivery/26-10-04"}}'
# NAS_PROJECT_DELIVERY_ROOT is optional and needed only when retaining an existing /delivery-project mount.
# 设为 NAS 交付目录属主的 UID/GID；飞牛常见值为 1000，应按实际权限核对。
BRIDGE_UID=1000
BRIDGE_GID=1000
